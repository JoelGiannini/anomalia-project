{
  "kind": "Dashboard",
  "metadata": {
    "name": "anomalia-stack"
  },
  "spec": {
    "display": {
      "name": "Anomalia - Stack",
      "description": "Telemetria propia del backend Anomalia: metricas expuestas en /metrics, trazas enviadas por OTLP a VictoriaTraces y perfilado continuo de CPU con Pyroscope."
    },
    "duration": "1h",
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "trace_id",
          "display": {
            "name": "Traza (trace ID)",
            "description": "ID de traza a inspeccionar. Pulsa el nombre de una fila de la tabla de trazas para rellenarlo."
          },
          "value": ""
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "trace_op",
          "display": {
            "name": "Operacion",
            "description": "Filtra la tabla por operacion exacta (p.ej. GET /metrics). Vacio = sin filtro."
          },
          "value": ""
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "trace_tags",
          "display": {
            "name": "Tags",
            "description": "Filtra por tags JSON del span (p.ej. {\"http.method\":\"GET\"}). Debe ser JSON valido. Vacio = sin filtro."
          },
          "value": ""
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "trace_min_dur",
          "display": {
            "name": "Duracion min.",
            "description": "Duracion minima de la traza (p.ej. 100ms, 1s). Vacio = sin filtro."
          },
          "value": ""
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "trace_max_dur",
          "display": {
            "name": "Duracion max.",
            "description": "Duracion maxima de la traza (p.ej. 500ms, 2s). Vacio = sin filtro."
          },
          "value": ""
        }
      }
    ],
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Anomalia",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/0_0"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 8,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/0_1"
              }
            },
            {
              "x": 16,
              "y": 0,
              "width": 8,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/0_2"
              }
            },
            {
              "x": 0,
              "y": 4,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/1_0"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/2_0"
              }
            },
            {
              "x": 12,
              "y": 12,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/2_1"
              }
            },
            {
              "x": 0,
              "y": 20,
              "width": 12,
              "height": 16,
              "content": {
                "$ref": "#/spec/panels/3_0"
              }
            },
            {
              "x": 12,
              "y": 20,
              "width": 12,
              "height": 16,
              "content": {
                "$ref": "#/spec/panels/3_1"
              }
            }
          ]
        }
      }
    ],
    "panels": {
      "0_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU %"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "colorMode": "value",
              "format": {
                "unit": "percent"
              },
              "sparkline": {},
              "thresholds": {
                "steps": [
                  { "color": "#73bf69", "value": 0 },
                  { "color": "#EAB839", "value": 70 },
                  { "color": "#E24D42", "value": 90 }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "xAnomaliaDatasource": "PrometheusDatasource",
                    "query": "anomalia_system_cpu_usage_percent"
                  }
                }
              }
            }
          ]
        }
      },
      "0_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "RAM %"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "colorMode": "value",
              "format": {
                "unit": "percent"
              },
              "sparkline": {},
              "thresholds": {
                "steps": [
                  { "color": "#73bf69", "value": 0 },
                  { "color": "#EAB839", "value": 80 },
                  { "color": "#E24D42", "value": 92 }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "xAnomaliaDatasource": "PrometheusDatasource",
                    "query": "anomalia_system_ram_usage_percent"
                  }
                }
              }
            }
          ]
        }
      },
      "0_2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Health"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "colorMode": "value",
              "format": {
                "unit": "decimal"
              },
              "thresholds": {
                "steps": [
                  { "color": "#E24D42", "value": 0 },
                  { "color": "#73bf69", "value": 1 }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "xAnomaliaDatasource": "PrometheusDatasource",
                    "query": "anomalia_health_status"
                  }
                }
              }
            }
          ]
        }
      },
      "1_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU / RAM del backend"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom",
                "values": ["last-number"]
              },
              "visual": {
                "display": "line",
                "connectNulls": false,
                "areaOpacity": 0.1,
                "lineWidth": 1,
                "showPoints": "auto"
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                },
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "xAnomaliaDatasource": "PrometheusDatasource",
                    "query": "anomalia_system_cpu_usage_percent",
                    "seriesNameFormat": "CPU"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "xAnomaliaDatasource": "PrometheusDatasource",
                    "query": "anomalia_system_ram_usage_percent",
                    "seriesNameFormat": "RAM"
                  }
                }
              }
            }
          ]
        }
      },
      "2_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Trazas del backend (Jaeger)"
          },
          "plugin": {
            "kind": "TraceTable",
            "spec": {
              "links": {
                "trace": "?var-trace_id=${traceId}"
              }
            }
          },
          "queries": [
            {
              "kind": "TraceQuery",
              "spec": {
                "plugin": {
                  "kind": "JaegerTraceQuery",
                  "spec": {
                    "xAnomaliaDatasource": "JaegerDatasource",
                    "service": "anomalia_system",
                    "operation": "$trace_op",
                    "tags": "$trace_tags",
                    "minDuration": "$trace_min_dur",
                    "maxDuration": "$trace_max_dur"
                  }
                }
              }
            }
          ]
        }
      },
      "2_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Traza seleccionada (Gantt)"
          },
          "plugin": {
            "kind": "TracingGanttChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TraceQuery",
              "spec": {
                "plugin": {
                  "kind": "JaegerTraceQuery",
                  "spec": {
                    "xAnomaliaDatasource": "JaegerDatasource",
                    "traceId": "$trace_id",
                    "service": "anomalia_system"
                  }
                }
              }
            }
          ]
        }
      },
      "3_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Perfil de CPU (flamegraph)"
          },
          "plugin": {
            "kind": "FlameChart",
            "spec": {
              "palette": "value",
              "showFlameGraph": true,
              "showSeries": true,
              "showSettings": true,
              "showTable": true,
              "traceHeight": 16
            }
          },
          "queries": [
            {
              "kind": "ProfileQuery",
              "spec": {
                "plugin": {
                  "kind": "PyroscopeProfileQuery",
                  "spec": {
                    "xAnomaliaDatasource": "PyroscopeDatasource",
                    "service": "anomalia_system",
                    "profileType": "process_cpu:cpu:nanoseconds:cpu:nanoseconds"
                  }
                }
              }
            }
          ]
        }
      },
      "3_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Perfil de memoria (flamegraph)"
          },
          "plugin": {
            "kind": "FlameChart",
            "spec": {
              "palette": "value",
              "showFlameGraph": true,
              "showSeries": true,
              "showSettings": true,
              "showTable": true,
              "traceHeight": 16
            }
          },
          "queries": [
            {
              "kind": "ProfileQuery",
              "spec": {
                "plugin": {
                  "kind": "PyroscopeProfileQuery",
                  "spec": {
                    "xAnomaliaDatasource": "PyroscopeDatasource",
                    "service": "anomalia_system",
                    "profileType": "memory:alloc_space:bytes:space:bytes"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
