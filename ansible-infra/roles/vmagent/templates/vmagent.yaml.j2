global:
  scrape_interval: 15s

scrape_configs:
{% if groups.get('vm_storage_nodes', []) | length > 0 %}
  - job_name: 'vm-storage'
    scheme: http
    static_configs:
      - targets:
{% for host in groups['vm_storage_nodes'] %}
          - '{{ hostvars[host].vmstorage_ip | default(hostvars[host].ansible_host) | default("127.0.0.1") }}:{{ hostvars[host].vmstorage_port | default("8402") }}'
{% endfor %}
{% endif %}
{% if groups.get('vm_insert_nodes', []) | length > 0 %}
  - job_name: 'vm-insert'
