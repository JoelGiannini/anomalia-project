global:
  scrape_interval: 15s

scrape_configs:
{% if infra_components is defined %}
{# ---------------------------------------------------------------------- #
   Modo dirigido (worker): la BD es la fuente de verdad (spec 005) y el
   inventario ad-hoc (-i {ip},) no expone grupos/hostvars. Los targets base
   se construyen a partir de la extra-var infra_components
   ([{component, ip, port}]) y los jobs por-tenant desde vmalert_instances
   (spec 011 §4.3). El mapeo componente -> job_name replica el modo
   inventario para que ambos modos produzcan la misma config.            #}
{% set jobmap = {
  'vmstorage':    'vm-storage',
  'vminsert':     'vm-insert',
  'vmselect':     'vm-select',
  'vlstorage':    'vlogs-storage',
  'vlinsert':     'vlogs-insert',
  'vlselect':     'vlogs-select',
  'vtstorage':    'vt-storage',
  'vtinsert':     'vt-insert',
  'vtselect':     'vt-select',
  'pyroscope':    'pyroscope',
  'vmauth':       'vmauth',
  'vmagent':      'vmagent',
  'alertmanager': 'alertmanager',
  'vmalert':      'vmalert',
  'backend':      'anomalia-backend',
  'parses':       'parses-service',
} %}
{% for comp, job_name in jobmap.items() %}
{% if infra_components | selectattr('component', 'equalto', comp) | list | length > 0 %}
  - job_name: '{{ job_name }}'
    scheme: http
    static_configs:
      - targets:
{% for node in infra_components | selectattr('component', 'equalto', comp) | list %}
          - '{{ node.ip }}:{{ node.port }}'
{% endfor %}
{% endif %}
{% endfor %}
{% else %}
{% if groups.get('vm_storage_nodes', []) | length > 0 %}
  - job_name: 'vm-storage'
    scheme: http
    static_configs:
      - targets:
{% for host in groups['vm_storage_nodes'] %}
          - '{{ hostvars[host].vmstorage_ip | default(hostvars[host].ansible_host) | default("127.0.0.1") }}:{{ hostvars[host].vmstorage_port | default("8402") }}'
{% endfor %}
{% endif %}
{% if groups.get('vm_insert_nodes', []) | length > 0 %}
  - job_name: 'vm-insert'
    scheme: http
    static_configs:
      - targets:
{% for host in groups['vm_insert_nodes'] %}
          - '{{ hostvars[host].vminsert_ip | default(hostvars[host].ansible_host) | default("127.0.0.1") }}:{{ hostvars[host].vminsert_port | default("8400") }}'
{% endfor %}
{% endif %}
{% if groups.get('vm_select_nodes', []) | length > 0 %}
  - job_name: 'vm-select'
    scheme: http
    static_configs:
      - targets:
{% for host in groups['vm_select_nodes'] %}
          - '{{ hostvars[host].vmselect_ip | default(hostvars[host].ansible_host) | default("127.0.0.1") }}:{{ hostvars[host].vmselect_port | default("8401") }}'
{% endfor %}
{% endif %}
{% if groups.get('vlogs_storage_nodes', []) | length > 0 %}
  - job_name: 'vlogs-storage'
    scheme: http
    static_configs:
      - targets:
{% for host in groups['vlogs_storage_nodes'] %}
