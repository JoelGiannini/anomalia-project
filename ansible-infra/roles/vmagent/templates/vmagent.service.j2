[Unit]
Description=Anomalia VictoriaMetrics Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/lib/anomalia/vmagent/data
{% if vmagent_remote_write_url is defined %}
{# Modo dirigido (spec 011 §4.3): la URL de remote-write llega por extra-var
   (el inventario ad-hoc no expone grupos para resolver vmauth). #}
ExecStart=/usr/local/bin/vmagent-prod -promscrape.config=/etc/anomalia/vmagent/vmagent.yaml -promscrape.config.strictParse=false -remoteWrite.url={{ vmagent_remote_write_url }} -httpListenAddr={{ vmagent_ip | default('127.0.0.1') }}:{{ vmagent_port | default('8429') }}
{% else %}
{# Resolver vmauth tolerando grupo vacío u omitido (spec 013). #}
{%- set vmauth_nodes = groups.get('vmauth_nodes', []) -%}
{%- set vmauth_host = vmauth_nodes[0] if vmauth_nodes else '' -%}
{%- set vmauth_addr = hostvars[vmauth_host].vmauth_ip | default(hostvars[vmauth_host].ansible_host) | default('127.0.0.1') if vmauth_host else '127.0.0.1' -%}
{%- set vmauth_port = hostvars[vmauth_host].vmauth_server_port | default('8427') if vmauth_host else '8427' -%}
ExecStart=/usr/local/bin/vmagent-prod -promscrape.config=/etc/anomalia/vmagent/vmagent.yaml -promscrape.config.strictParse=false -remoteWrite.url=http://{{ vmauth_addr }}:{{ vmauth_port }}/insert/prometheus/api/v1/write?tenant=METRICS -httpListenAddr={{ vmagent_ip | default(ansible_host) | default('127.0.0.1') }}:{{ vmagent_port | default('8429') }}
{% endif %}
Restart=on-failure

[Install]
WantedBy=multi-user.target