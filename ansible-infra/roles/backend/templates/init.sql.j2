-- =========================================================================
-- INFRAESTRUCTURA, OIDC Y MONITOREO
-- =========================================================================

-- Crear tabla general para nodos e infraestructura de componentes (con soporte de service_ip y credenciales de soporte)
CREATE TABLE IF NOT EXISTS infrastructure_nodes (
    id SERIAL PRIMARY KEY,
    hostname VARCHAR(150) NOT NULL,
    ip_address VARCHAR(50) NOT NULL,      -- IP de acceso al host (ansible_host)
    service_ip VARCHAR(50),               -- IP de servicio (si no se define en inventario, usa la de host)
    component_type VARCHAR(50) NOT NULL DEFAULT 'auth',
    port INTEGER DEFAULT 8427,
    admin_username VARCHAR(100) DEFAULT 'anomalia', -- Usuario de administración/soporte en el nodo
    admin_password TEXT,                            -- Contraseña en texto plano del usuario de soporte generada por OpenSSL
    status VARCHAR(50) DEFAULT 'operational',
    is_active BOOLEAN DEFAULT TRUE,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, 
    CONSTRAINT unique_host_component UNIQUE (hostname, component_type)
);

-- Crear tabla para la configuración dinámica de Proveedores de Identidad (IdP / OIDC)
CREATE TABLE IF NOT EXISTS oidc_providers (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    client_id VARCHAR(255) NOT NULL,
    client_secret TEXT DEFAULT '',
    issuer_url TEXT NOT NULL,
    redirect_uri TEXT DEFAULT '',
    is_active BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Nota: no se siembra ningún proveedor OIDC. Keycloak se retiró del stack por
-- ser una dependencia exclusiva de pruebas. Los proveedores reales se dan de
-- alta desde la app móvil (GET/POST /api/v1/oidc/providers) o por consola SQL,
-- con secretos gestionados fuera del repositorio.

-- Tabla de configuración del proveedor de IA (fila única). Las API keys
-- (Zen / Gemini) se ingresan desde el panel de control y viven solo aquí,
-- nunca en archivos del repositorio. Ver specs/003-aiops-alert-pipeline.md §2.
CREATE TABLE IF NOT EXISTS ai_settings (
    id SERIAL PRIMARY KEY,
    selected_provider VARCHAR(100) DEFAULT 'anomalia_ollama',
    zen_api_key TEXT DEFAULT '',
    gemini_api_key TEXT DEFAULT '',
    gemini_model VARCHAR(100) DEFAULT 'gemini-3.5-flash-lite',
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO ai_settings (selected_provider)
SELECT 'anomalia_ollama'
WHERE NOT EXISTS (SELECT 1 FROM ai_settings);

-- Tabla para almacenar el historial de alertas y análisis de IA
CREATE TABLE IF NOT EXISTS alert_history (
    id SERIAL PRIMARY KEY,
    alertname VARCHAR(255) NOT NULL,
    severity VARCHAR(50),
    summary TEXT,
    description TEXT,
    ai_analysis TEXT,
    status VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabla para registrar los dispositivos móviles (APK / Android)
CREATE TABLE IF NOT EXISTS user_devices (
    id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    fcm_token TEXT UNIQUE NOT NULL,
    platform VARCHAR(50) DEFAULT 'android',
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

