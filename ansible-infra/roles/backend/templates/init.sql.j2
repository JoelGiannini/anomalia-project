{% set ns = namespace(rows=[]) %}
{% for comp in component_groups %}
  {% if groups[comp.group] is defined and groups[comp.group] | length > 0 %}
    {% for host in groups[comp.group] %}
      {# IP de acceso al host (ansible_host) #}
      {% set host_ip = hostvars[host].ansible_host | default('127.0.0.1') %}
      
      {# IP de servicio #}
      {% set srv_ip = hostvars[host][comp.ip_var] | default(hostvars[host].service_ip) | default(host_ip) %}
      
      {% set h_port = hostvars[host][comp.port_var] | default(comp.default_port) %}
      {% set node_user = hostvars[host].nombre_usuario | default('anomalia') %}
      {% set node_pass = hostvars[host].clave_texto_plano | default('') %}
      
      {% set row_str = "('" ~ host ~ "', '" ~ host_ip ~ "', '" ~ srv_ip ~ "', '" ~ comp.type ~ "', " ~ h_port ~ ", '" ~ node_user ~ "', '" ~ node_pass ~ "', 'operational', '" ~ comp.desc ~ "')" %}
      {% set ns.rows = ns.rows + [row_str] %}
    {% endfor %}
  {% endif %}
{% endfor %}

{% if ns.rows | length > 0 %}
INSERT INTO infrastructure_nodes (hostname, ip_address, service_ip, component_type, port, admin_username, admin_password, status, description) VALUES
{{ ns.rows | join(',\n') }}
ON CONFLICT (hostname, component_type) DO UPDATE SET 
    ip_address = EXCLUDED.ip_address,
