-- Definir el endpoint de lectura de cada tenant a partir de los nodos select del inventario.
-- El tenant se empareja por nombre, de modo que el seed es idempotente y sobrevive a un
-- destroy/redeploy sin duplicar filas.
--
-- Nota sobre 'kind': identifica el backend de almacenamiento, NO el formato de la API.
--   METRICS      -> VictoriaMetrics,  API Prometheus  (prefijo /select/<a>:<p>/prometheus)
--   AUDIT_LOGS   -> VictoriaLogs,     API LogsQL     (scoping por headers)
--   PROFILES     -> Pyroscope,        API /pyroscope/render
--   TRACES       -> VictoriaTraces,   API compatible con Jaeger (/select/jaeger/api/*);
--                   se llama VictoriaTraces porque ese es el componente desplegado. No hay
--                   ningun componente Jaeger en el stack. VictoriaTraces NO expone la API
--                   de Tempo (/api/v2/...), por lo que el plugin Tempo de Perses no aplica.
{% set vm_sel = hostvars[groups['vm_select_nodes'][0]] %}
{% set vl_sel = hostvars[groups['vlogs_select_nodes'][0]] %}
{% set vt_sel = hostvars[groups['vt_select_nodes'][0]] %}
{% set pyro   = hostvars[groups['pyroscope_nodes'][0]] %}
INSERT INTO tenant_datasources (tenant_id, kind, read_url, scoping, account_id, project_id, org_id, enabled)
SELECT t.id, v.kind, v.read_url, v.scoping, v.account_id, v.project_id, v.org_id, TRUE
FROM tenants t
JOIN (VALUES
    ('METRICS',     'VictoriaMetrics', 'http://{{ vm_sel.vmselect_ip | default(vm_sel.ansible_host) }}:{{ vm_sel.vmselect_port }}', 'path',   0, 0, NULL),
    ('AUDIT_LOGS',  'VictoriaLogs', 'http://{{ vl_sel.vlselect_ip | default(vl_sel.ansible_host) }}:{{ vl_sel.vlselect_port }}',     'header', 0, 3, NULL),
    ('PROFILES',    'Pyroscope',    'http://{{ pyro.pyroscope_ip | default(pyro.ansible_host) }}:{{ pyro.pyroscope_port }}',         'header', NULL, NULL, 'PROFILES'),
    ('TRACES',      'VictoriaTraces', 'http://{{ vt_sel.vtselect_ip | default(vt_sel.ansible_host) }}:{{ vt_sel.vtselect_port }}', 'header', 0, 1, NULL)
) AS v(tenant_name, kind, read_url, scoping, account_id, project_id, org_id)
  ON v.tenant_name = t.name
ON CONFLICT (tenant_id) DO UPDATE SET
    kind = EXCLUDED.kind,
    read_url = EXCLUDED.read_url,
    scoping = EXCLUDED.scoping,
    account_id = EXCLUDED.account_id,
    project_id = EXCLUDED.project_id,
    org_id = EXCLUDED.org_id,
    enabled = TRUE;

