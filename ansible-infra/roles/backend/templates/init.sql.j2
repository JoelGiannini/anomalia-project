-- =========================================================================
-- ESQUEMA INICIAL DE BASE DE DATOS - ANOMALIA PROJECT (ABM & INFRAESTRUCTURA)
-- =========================================================================

-- 1. Crear tabla de roles primero por la clave foránea
CREATE TABLE IF NOT EXISTS roles (
    id SERIAL PRIMARY KEY,
    name VARCHAR(50) UNIQUE NOT NULL,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Crear tabla de perfiles de acceso
CREATE TABLE IF NOT EXISTS profiles (
    id SERIAL PRIMARY KEY,
    code VARCHAR(50) UNIQUE NOT NULL,
    name VARCHAR(100) NOT NULL,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. Tabla intermedia para la relación N a M entre roles y perfiles
CREATE TABLE IF NOT EXISTS role_profiles (
    role_id INTEGER REFERENCES roles(id) ON DELETE CASCADE,
    profile_id INTEGER REFERENCES profiles(id) ON DELETE CASCADE,
    PRIMARY KEY (role_id, profile_id)
);

-- 4. Crear tabla de tenants (entornos, proyectos o cuentas de VictoriaMetrics/VictoriaLogs/Pyroscope)
CREATE TABLE IF NOT EXISTS tenants (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,      -- Ej: 'METRICS', 'TRACES', 'PROFILES', 'AUDIT_LOGS'
    type VARCHAR(50) DEFAULT 'metrics',     -- Tipo de tenant: 'metrics', 'traces', 'profiles', 'logs'
    account_id INTEGER,                     -- AccountID para VictoriaMetrics/Logs (NULL si no aplica)
    project_id INTEGER,                     -- ProjectID para VictoriaMetrics/Logs (NULL si no aplica)
    environment VARCHAR(50),                -- Ej: 'work', 'live', 'play', 'default'
    port INTEGER DEFAULT 8427,              -- Puerto de escucha del servicio (ej: vmauth, vm, vlogs, pyroscope)
    description TEXT,
    -- Marca el tenant cuya telemetría es pista de auditoría. No basta con el
    -- type ('logs'): AUDIT_LOGS también es de tipo logs y sin esta bandera
    -- aparecía duplicado en la pestaña Logs y ausente de la de Auditoría.
    is_audit BOOLEAN NOT NULL DEFAULT false,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 4.1 Tabla que define el endpoint de LECTURA de cada tenant (base de los datasources de Perses).
-- tenants.port es el puerto de INSERCIÓN y no permite derivar la URL de lectura, por eso
-- se modela aparte. scoping indica cómo se aísla el tenant en el backend Victoria.
CREATE TABLE IF NOT EXISTS tenant_datasources (
    tenant_id INTEGER PRIMARY KEY REFERENCES tenants(id) ON DELETE CASCADE,
    kind VARCHAR(50) NOT NULL,              -- Backend de almacenamiento: VictoriaMetrics | VictoriaLogs | VictoriaTraces | Pyroscope
    read_url TEXT NOT NULL,                 -- URL base del backend de lectura
    scoping VARCHAR(20) NOT NULL DEFAULT 'header',  -- 'path' = prefijo /select/a:p/ | 'header' = AccountID/ProjectID
    account_id INTEGER,                     -- Valor de aislamiento (NULL si no aplica)
    project_id INTEGER,                     -- Valor de aislamiento (NULL si no aplica)
    org_id VARCHAR(255),                    -- Valor de X-Scope-OrgID (solo tipo profiles)
    enabled BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 5. Tabla intermedia para asociar roles a múltiples tenants (Relación N a M)
CREATE TABLE IF NOT EXISTS role_tenants (
    role_id INTEGER REFERENCES roles(id) ON DELETE CASCADE,
    tenant_id INTEGER REFERENCES tenants(id) ON DELETE CASCADE,
    PRIMARY KEY (role_id, tenant_id)
);

-- 6. Crear tabla de usuarios
CREATE TABLE IF NOT EXISTS users (
    id SERIAL PRIMARY KEY,
    username VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    avatar_url TEXT DEFAULT '',
    theme VARCHAR(50) DEFAULT 'theme-enterprise-blue',
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 7. Tabla intermedia para permitir múltiples roles por usuario (N a M)
CREATE TABLE IF NOT EXISTS user_roles (
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    role_id INTEGER REFERENCES roles(id) ON DELETE CASCADE,
    PRIMARY KEY (user_id, role_id)
);

-- 8. Tabla intermedia para asignación directa de tenants por usuario (N a M)
-- Debe declararse después de 'users' por la clave foránea.
CREATE TABLE IF NOT EXISTS user_tenants (
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    tenant_id INTEGER REFERENCES tenants(id) ON DELETE CASCADE,
    PRIMARY KEY (user_id, tenant_id)
);

-- Índices de acceso a tenants por usuario
CREATE INDEX IF NOT EXISTS idx_user_tenants_user_id ON user_tenants(user_id);

-- 9. Crear tabla de sesiones para validación por session_id
CREATE TABLE IF NOT EXISTS sessions (
    id SERIAL PRIMARY KEY,
    session_id VARCHAR(255) UNIQUE NOT NULL,
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    expires_at TIMESTAMP NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Índices de rendimiento para sesiones
CREATE INDEX IF NOT EXISTS idx_sessions_session_id ON sessions(session_id);
CREATE INDEX IF NOT EXISTS idx_sessions_user_id ON sessions(user_id);

-- Tickets de un solo uso para abrir la UI de Victoria de un tenant.
-- El token JWT vive en localStorage y no viaja en la navegacion, asi que el
-- frontend canjea un ticket opaco por la sesion y navega a la UI con el.
-- El tenant y el usuario se congelan aqui: la UI servida no vuelve a consultar
-- la autorizacion, por lo que el ticket caduca a los pocos minutos.
CREATE TABLE IF NOT EXISTS ui_tickets (
    id SERIAL PRIMARY KEY,
    ticket VARCHAR(128) UNIQUE NOT NULL,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    tenant_id INTEGER NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    -- Alcance de la tarjeta que emitio el ticket (UI_SCOPE_PROFILE). Determina el
    -- upstream al que se monta la consola: los scopes de Victoria van a su UI,
    -- "dashboards" va a Parses. Ver specs/010.
    scope VARCHAR(32) NOT NULL DEFAULT 'metrics',
    expires_at TIMESTAMP NOT NULL,
    consumed_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_ui_tickets_ticket ON ui_tickets(ticket);
CREATE INDEX IF NOT EXISTS idx_ui_tickets_expires ON ui_tickets(expires_at);

