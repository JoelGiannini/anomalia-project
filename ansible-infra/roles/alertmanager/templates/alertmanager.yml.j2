# Receiver sin integraciones (solo consola): Alertmanager agrupa y muestra
# las alertas en su UI pero no notifica por email ni webhook por ahora.
# Reactivacion de notificaciones: ver spec 003 §1.2 (webhook con gap 401/301
# pendiente) y el SMTP/email original.
route:
  group_by:
    - alertname
    - namespace
    - pod
    - instance
    - severity
    - app
    - mountpoint
    - cluster
    - container
    - phase
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
  receiver: 'console'

receivers:
  - name: 'console'
