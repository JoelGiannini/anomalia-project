route:
  group_by:
    - alertname
    - namespace
    - pod
    - instance
    - severity
    - app
    - mountpoint
    - cluster
    - container
    - phase
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
  receiver: 'email-y-webhook'

receivers:
  - name: 'email-y-webhook'
    email_configs:
      - to: '{{ mail }}'
        from: 'alerts@anomalia.local'
        smarthost: '{{ smtp_server_ip }}:{{ smtp_server_port }}'
        send_resolved: true
        require_tls: false
    webhook_configs:
      - url: 'http://{{ backend_ip }}:8000/api/v1/webhook/alertmanager'
        send_resolved: true
