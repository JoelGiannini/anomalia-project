[Unit]
Description=vmalert (Anomalia){{ " - " + item.tenant_slug if item is defined else "" }}

[Service]
User=root
ExecStart=/usr/local/bin/vmalert   --datasource.url=http://{{ hostvars[groups['vm_select_nodes'][0]].ansible_host | default('127.0.0.1') }}:{{ hostvars[groups['vm_select_nodes'][0]].vmselect_port | default('8401') }}   --remoteRead.url=http://{{ hostvars[groups['vm_select_nodes'][0]].ansible_host | default('127.0.0.1') }}:{{ hostvars[groups['vm_select_nodes'][0]].vmselect_port | default('8401') }}   --remoteWrite.url=http://{{ hostvars[groups['vm_insert_nodes'][0]].ansible_host | default('127.0.0.1') }}:{{ hostvars[groups['vm_insert_nodes'][0]].vminsert_port | default('8400') }}   -notifier.url=http://{{ hostvars[groups['alertmanager_nodes'][0]].ansible_host | default('127.0.0.1') }}:{{ hostvars[groups['alertmanager_nodes'][0]].alertmanager_port | default('9093') }}   -rule={{ item.rules_path + '/alert_rules.yml' if item is defined else '/etc/anomalia/vmalert/alert_rules.yml' }}   --httpListenAddr=:{{ item.port if item is defined else '8880' }}   -evaluationInterval=15s
Restart=always

[Install]
WantedBy=multi-user.target
